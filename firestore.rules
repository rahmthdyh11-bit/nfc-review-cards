rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
             && request.auth.uid == "av9KUag1ovbYg8UAQM78Q5p5peF3";
    }

    function isFirstActivation() {
      return resource.data.active == false
             && resource.data.destination == ""
             && request.resource.data.active == true
             && request.resource.data.shopName is string
             && request.resource.data.shopName.size() >= 2
             && request.resource.data.shopName.size() <= 100
             && request.resource.data.shopLocation is string
             && request.resource.data.shopLocation.size() >= 2
             && request.resource.data.shopLocation.size() <= 100
             && request.resource.data.destination is string
             && request.resource.data.destination.matches(
                  '^https://(g[.]page/r/[^/]+/review([?].*)?|search[.]google[.]com/local/writereview[?].+)$'
                )
             && request.resource.data.keys().hasAll([
               'shopName',
               'shopLocation',
               'destination',
               'active'
             ])
             && request.resource.data.keys().hasOnly([
               'shopName',
               'shopLocation',
               'destination',
               'active'
             ])
             && request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    'shopName',
                    'shopLocation',
                    'destination',
                    'active'
                  ]);
    }

    match /cards/{cardId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isFirstActivation();
    }
  }
}
